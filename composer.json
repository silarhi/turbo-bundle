{
    "name": "silarhi/turbo-bundle",
    "description": "Framework-agnostic Hotwire Turbo frame-redirect following and turbo_frame Twig filter for Symfony — the PHP companion to @silarhi/turbo",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "turbo",
        "hotwire",
        "symfony",
        "turbo-frame",
        "symfony-bundle",
        "symfony-ux",
        "turbo-stream",
        "twig"
    ],
    "authors": [
        {
            "name": "SILARHI",
            "email": "dev@silarhi.fr"
        }
    ],
    "homepage": "https://turbo-bundle.silarhi.dev",
    "support": {
        "issues": "https://github.com/silarhi/turbo-bundle/issues",
        "source": "https://github.com/silarhi/turbo-bundle",
        "docs": "https://turbo-bundle.silarhi.dev"
    },
    "require": {
        "php": ">=8.2",
        "symfony/event-dispatcher": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.54.0",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.2",
        "phpstan/phpstan-strict-rules": "^2.1.0",
        "phpstan/phpstan-symfony": "^2.1.0",
        "phpunit/phpunit": "^11.5.57 || ^12.5.38 || ^13.4.1",
        "rector/rector": "^2.7.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/error-handler": "^6.4 || ^7.0 || ^8.0",
        "twig/twig": "^3.0"
    },
    "conflict": {
        "symfony/config": "<6.4",
        "symfony/dependency-injection": "<6.4"
    },
    "suggest": {
        "symfony/framework-bundle": "Register Silarhi\\TurboBundle\\SilarhiTurboBundle for zero-config service wiring (optional — TurboManager, TurboFrameListener and TurboExtension work without it, and without symfony/dependency-injection)",
        "twig/twig": "Enables the `turbo_frame` Twig filter (auto-registered by SilarhiTurboBundle when present)"
    },
    "autoload": {
        "psr-4": {
            "Silarhi\\TurboBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Silarhi\\TurboBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true
        },
        "audit": {
            "block-insecure": false
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "scripts": {
        "bump:tools": "@composer bump ergebnis/composer-normalize friendsofphp/php-cs-fixer phpstan/* phpunit/phpunit rector/rector",
        "test": "phpunit"
    }
}
