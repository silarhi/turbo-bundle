{
    "name": "@silarhi/turbo",
    "description": "Framework-agnostic Hotwire Turbo lifecycle orchestrator — mount/unmount your listeners across Turbo Drive, Frames and Streams",
    "version": "0.0.0-development",
    "license": "MIT",
    "author": "SILARHI <dev@silarhi.fr>",
    "homepage": "https://turbo-bundle.silarhi.dev",
    "keywords": [
        "turbo",
        "hotwire",
        "turbo-stream",
        "turbo-frame",
        "morph",
        "stimulus",
        "symfony-ux"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/silarhi/turbo-bundle.git"
    },
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "dist/index.mjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "scripts": {
        "build": "tsdown",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "biome check src test e2e playwright.config.ts",
        "lint:fix": "biome check --write src test e2e playwright.config.ts",
        "e2e": "pnpm build && playwright test"
    },
    "peerDependencies": {
        "@hotwired/turbo": "^7.1.0 || ^8.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.3",
        "@hotwired/turbo": "^8.0.0",
        "@playwright/test": "^1.64.1",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.0.5",
        "jsdom": "^30.0.0",
        "tsdown": "^0.23.1",
        "typescript": "^7.0.0",
        "vite": "^8.0.0",
        "vitest": "^5.0.0"
    },
    "packageManager": "pnpm@12.15.0"
}
